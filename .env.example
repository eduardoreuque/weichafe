# Copia este archivo a .env y ajusta los valores locales.
# NUNCA versiones .env (ya está en .gitignore). Solo commit .env.example

# URL de la base de datos SQLite (relativa a prisma/)
DATABASE_URL="file:./dev.db"

# Secreto para firmar las sesiones (JWT). En producción es OBLIGATORIO
# y debe ser un valor largo y aleatorio único (ej: openssl rand -hex 32)
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres"

# Marca la cookie como Secure (SOLO si sirves vía HTTPS)
COOKIE_SECURE="false"

# Directorio donde se guardan las fotos/de uploads. Vacío = public/uploads
UPLOAD_DIR=""

# ---------------------------------------------------------------
# RECUPERACIÓN DE ACCESO (opcional)
# ---------------------------------------------------------------
# Permite volver a entrar si te quedas sin acceso, desde el navegador
# del celular: https://tu-servidor/recovery
#
# RECOVERY_CODE: código maestro que SOLO tú conoces (mín. 16 caracteres).
#   Si no se define, la recuperación queda desactivada.
# RECOVERY_EMAIL: cuenta a la que se le cambia la clave (default: primer ADMIN).
RECOVERY_CODE=""
RECOVERY_EMAIL=""