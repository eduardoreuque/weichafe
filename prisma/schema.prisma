generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Discipline {
  MMA
  KICK
  BOXEO
  JIU_JITSU
  MUAY_THAI
  FUNCIONAL
  OTRO
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_DEBITO
  TARJETA_CREDITO
}

enum MonthlyStatus {
  PAGADO
  PENDIENTE
  SALTADO
}

model Student {
  id               String           @id @default(cuid())
  fullName         String
  rut              String?          // RUT chileno
  birthDate        DateTime
  email            String?
  whatsapp         String?
  address          String?
  district         String?
  emergencyContact String?          // Nombre del contacto de emergencia
  emergencyPhone   String?
  notes            String?          // Observaciones
  photoUrl         String?          // URL de la foto del alumno
  isActive         Boolean          @default(true)  // Alumno activo/inactivo
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  monthlyPayments MonthlyPayment[]
  dailyClassSales DailyClassSale[]
  receipts        Receipt[]
}

model MonthlyPayment {
  id            String        @id @default(cuid())
  studentId     String
  discipline    Discipline
  disciplines   String?       // Multi-disciplina separada por coma (ej: "MMA,BJJ")
  status        MonthlyStatus @default(PAGADO)
  monthCovered  DateTime
  amount        Int
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  notes         String?
  createdAt     DateTime      @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  receipt Receipt?

  @@index([studentId, monthCovered])
}

model DailyClassSale {
  id            String        @id @default(cuid())
  studentId     String?
  attendeeName  String?
  discipline    String        // Ahora es String para soportar múltiples disciplinas (ej: "MMA,BJJ")
  classDate     DateTime
  amount        Int
  paymentMethod PaymentMethod
  notes         String?
  createdAt     DateTime      @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  receipt Receipt?

  @@index([classDate])
}

model Receipt {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  issuedAt        DateTime      @default(now())
  amount          Int
  description     String
  paymentMethod   PaymentMethod
  studentId       String
  monthlyPaymentId String?      @unique
  dailyClassSaleId String?      @unique

  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  monthlyPayment MonthlyPayment? @relation(fields: [monthlyPaymentId], references: [id], onDelete: SetNull)
  dailyClassSale DailyClassSale? @relation(fields: [dailyClassSaleId], references: [id], onDelete: SetNull)

  @@index([studentId, issuedAt])
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}